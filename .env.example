# Codivio environment variables
# Never put real secrets in this file.

VITE_APP_NAME=Codivio

# GA4 Measurement ID (format: G-XXXXXXXXXX). Not a secret — GA4 Measurement
# IDs are public by design (visible in every page's network requests on any
# GA4-instrumented site). Leave unset to run with analytics disabled
# (src/lib/analytics.ts safely no-ops: no script is loaded, no event is
# ever sent). Set it in your build environment (e.g. .env.production, or
# your CI/deploy environment variables) before `npm run build` to enable
# real GA4 tracking in that build.
VITE_GA4_MEASUREMENT_ID=